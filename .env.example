# Copy this file to .env and fill in your Supabase project's values:
# Dashboard → Project Settings → API (or "Connect" → App Frameworks).
# The anon/publishable key is meant to be public; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
